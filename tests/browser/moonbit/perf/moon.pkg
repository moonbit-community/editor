import {
  "moonbit-community/editor/base/common" @base_common,
  "moonbit-community/editor/viewer",
  "moonbit-community/editor/internal/viewer/browser/testing" @viewer_testing,
  "moonbit-community/editor/viewer/common/languages",
  "moonbit-community/editor/syntax/lang_moonbit",
  "moonbit-community/editor/tests/browser/moonbit/support",
  "moonbit-community/rabbita/dom" @rdom,
}

supported_targets = "js"

pkgtype(kind: "executable")

